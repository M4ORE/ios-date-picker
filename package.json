{
  "name": "@m4ore/ios-date-picker",
  "version": "1.0.3",
  "type": "module",
  "description": "iOS-styled date picker component with wheel picker and calendar grid for web applications",
  "keywords": [
    "datepicker",
    "date-picker",
    "ios",
    "calendar",
    "wheel-picker",
    "vanilla-js",
    "no-dependencies"
  ],
  "author": "M4ORE",
  "license": "MIT",
  "main": "dist/ios-date-picker.umd.js",
  "module": "dist/ios-date-picker.esm.js",
  "exports": {
    ".": {
      "import": "./dist/ios-date-picker.esm.js",
      "require": "./dist/ios-date-picker.umd.js"
    },
    "./css": "./dist/ios-date-picker.css"
  },
  "scripts": {
    "build": "rollup -c && node scripts/build-css.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "vanilla-calendar-pro": "^2.9.0"
  },
  "devDependencies": {
    "storybook": "^8.5.8",
    "@storybook/html-vite": "^8.5.8",
    "@storybook/addon-essentials": "^8.5.8",
    "@storybook/addon-interactions": "^8.5.8",
    "@storybook/addon-a11y": "^8.5.8",
    "vite": "^5.4.11",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.9.0",
    "vanilla-calendar-pro": "^2.9.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
